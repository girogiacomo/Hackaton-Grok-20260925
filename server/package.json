{
  "name": "sidequest-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "description": "Relay between Cursor hooks and the Sidequest phone app",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx scripts/simulate.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.0.2",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.4.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3"
  }
}
