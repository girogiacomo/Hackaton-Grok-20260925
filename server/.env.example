# xAI key for Grok-generated challenges, progress notes and done summaries.
# Without it the relay still works with canned content.
XAI_API_KEY=
GROK_MODEL=grok-4-fast
# XAI_BASE_URL=https://api.x.ai/v1

# Relay settings
PORT=80
# Fix the pairing code instead of generating one per start (handy for demos).
# PAIR_CODE=123456
# Override the URL printed in the QR (e.g. when tunnelling or deployed).
# PUBLIC_URL=https://sidequest.example.com
# SIDEQUEST_DB=sidequest.db
